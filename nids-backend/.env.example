GOOGLE_API_KEY=your_google_api_key_here

# Optional API security (implemented, off by default).
# If set, all /api/* requests (except /health, /docs) must send:
#   X-API-Key: <value>
# CORS is NOT authentication — set this for any non-localhost deployment.
NIDS_API_SECRET=
# Per-IP rate limit (requests per minute). Default 120.
NIDS_RATE_LIMIT=120

# Automatically start the packet sniffer on FastAPI startup (1/true/yes).
NIDS_CAPTURE=0